# Copy this file to .env. DIRECT_ENGINE selects the direct-video branch.
# auto preserves provider-based legacy behaviour; set wan, ltx, or runway to lock one branch.
DIRECT_ENGINE=wan
DASHSCOPE_API_KEY=
# RUNWAYML_API_SECRET=

# Local LTX branch (ComfyUI API). These are not needed for Wan.
# LTX_MODEL=ltxv-2b-0.9.8-distilled-fp8
# LTX_COMFYUI_URL=http://127.0.0.1:8188
# LTX_COMFYUI_INPUT_DIR=C:\path\to\ComfyUI\input
# LTX_COMFYUI_WORKFLOW=C:\path\to\ltx-v2v-api.json
# LTX_COMFYUI_TIMEOUT_SECONDS=3600
